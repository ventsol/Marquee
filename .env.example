# Discord bot token (https://discord.com/developers/applications)
DISCORD_TOKEN=your-token-here

# Optional comma-separated guild IDs for instant slash-command sync during dev.
# Leave blank for global commands (can take up to an hour to propagate).
DEV_GUILD_IDS=

# Poll interval in minutes (default 15)
POLL_INTERVAL_MINUTES=15

# Skip announcing the initial backlog on a fresh database
SEED_QUIETLY=true

# How aggressively to filter studio uploads:
#   trailers -> trailers + teasers only (default, recommended)
#   promo    -> also first-looks and official clips
#   all      -> announce every upload
FILTER_MODE=trailers

# SQLite location
DATABASE_PATH=data/trailer.db

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Max seconds to wait for a single RSS fetch
HTTP_TIMEOUT_SECONDS=15

# Max concurrent RSS fetches
HTTP_CONCURRENCY=8

# ── Web dashboard (app.py) ───────────────────────────────────────────────────
# REQUIRED to start the dashboard. It can rewrite studios.toml and delete
# studios, so there is no default.
WEBAPP_PASSWORD=change-me

# Bind address. Keep 127.0.0.1 unless you're putting this behind a real proxy.
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8000

# Run the Discord bot inside the dashboard process.
# Set false to serve the dashboard only (e.g. while bot.py runs elsewhere).
WEBAPP_RUN_BOT=true
